# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public (safe in the browser)
# Optional: only needed for a custom domain
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (never prefix these with NEXT_PUBLIC_)
OWNER_EMAIL=

# AI (server only). The key is created at console.anthropic.com
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
# Optional. Defaults to claude-opus-5-5. Cheaper: claude-sonnet-5-5 or claude-haiku-5-5
AI_MODEL=
